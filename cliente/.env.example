# Copia este archivo a .env para desarrollo local.
# NOTA: .env esta en .dockerignore y en .gitignore; nunca se versiona.
# En el contenedor, API_URL la inyecta la ejecucion del pod
# (scripts/levantar.ps1: http://crm-backend:3000).

# URL de la API a la que el proxy /api del frontend reenvia las peticiones.
API_URL=http://localhost:8080
