# Copia este archivo a .env y ajusta los valores.
# NOTA: .env esta en .dockerignore (no se mete en la imagen); en contenedor,
# las SMTP_* se inyectan en tiempo de ejecucion desde este archivo (ver
# scripts/levantar.ps1 y infra/compose-backend.yml).

# --- Base de datos (desarrollo local contra el pod de Podman, publicado en
# el anfitrión en :5433) ---
DATABASE_URL=postgres://crm:crm@localhost:5433/crmdb

# --- Proxy / adapter-node ---
# adapter-node asume 'https' y su propio host por defecto (asume TLS en un
# proxy). El proxy del frontend envia x-forwarded-proto y x-forwarded-host con
# el origin publico real; sin leerlos, Better Auth no enruta /api/auth/* y
# rechaza el Origin del navegador (CSRF).
PROTOCOL_HEADER=x-forwarded-proto
HOST_HEADER=x-forwarded-host

# --- Better Auth ---
# Secreto para firmar cookies de sesion: >=32 caracteres. Generar con
# `openssl rand -base64 32`. Obligatorio en produccion.
BETTER_AUTH_SECRET=pon-aqui-un-secreto-de-al-menos-32-caracteres
# URL publica del FRONTEND (el origin que usa el navegador). Better Auth la usa
# como baseURL y para validar el Origin (CSRF). En el contenedor la pisa el
# Dockerfile con http://localhost:4173.
BETTER_AUTH_URL=http://localhost:5173
# Origenes del frontend confiables para Better Auth, separados por coma (CSRF).
TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- SMTP (envio del OTP de login) ---
# Mientras SMTP_HOST este vacio, el sistema entra en MODO DEV: el codigo de
# 6 digitos se imprime en la consola del servidor en vez de enviarse por mail.
# Para envio real (ej. Gmail): usar una "app password" (16 caracteres) como
# SMTP_PASS, no la clave normal de la cuenta.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu-correo@correo.com
SMTP_PASS=tu-app-password-de-16-digitos
SMTP_FROM=tu-correo@correo.com

# --- Cifrado de credenciales de correo ---
# Clave maestra (>=16 caracteres) para cifrar las contrasenas SMTP guardadas
# en la base. Sin esta variable no se pueden crear ni usar cuentas de correo.
CORREO_CLAVE=generar-con-openssl-rand-base64-32

# --- Gmail API (OAuth 2.0) ---
# Se usa para seguimientos y tickets. Sin CLIENT_ID/SECRET, "Conectar Gmail"
# queda deshabilitado en Configuracion > Correo.
GMAIL_CLIENT_ID=tu-client-id.apps.googleusercontent.com
GMAIL_CLIENT_SECRET=tu-client-secret
# Default: <BETTER_AUTH_URL>/api/gmail/oauth/callback
GMAIL_REDIRECT_URI=http://localhost:5173/api/gmail/oauth/callback
# Cada cuantos minutos se consultan las casillas. Default 2.
GMAIL_SYNC_INTERVALO_MINUTOS=2
# Opcionales: notificaciones push de Google Pub/Sub. Sin ellos se usa sondeo.
GMAIL_PUBSUB_TOPIC=projects/tu-proyecto/topics/tu-topic
GMAIL_PUBSUB_SECRET=secreto-aleatorio-para-la-url-del-push

# --- Webhook de correo entrante de tickets ---
# Se exige en la cabecera x-ticket-secret. Si falta, el webhook queda cerrado.
TICKETS_EMAIL_WEBHOOK_SECRET=secreto-compartido-con-el-conector

# --- WhatsApp (Baileys) ---
# Carpeta persistente con las credenciales de la sesion. En el pod se monta
# como volumen; si se pierde, hay que volver a escanear el QR.
WHATSAPP_AUTH_DIR=.whatsapp-auth
